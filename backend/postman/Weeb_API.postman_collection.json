{
  "info": {
    "name": "Weeb API",
    "description": "Collection de test de l'API REST du blog Weeb.\n\nLes requêtes Login et Signup enregistrent automatiquement les tokens dans les variables de collection `access_token` et `refresh_token` : il n'y a donc rien à copier-coller à la main.\n\nOrdre d'utilisation conseillé :\n1. Auth > Signup\n2. Valider le compte dans l'admin Django (http://127.0.0.1:8000/admin/)\n3. Auth > Login\n4. Articles > Créer un article",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "article_slug", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/signup/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"ada@weeb.fr\",\n  \"password\": \"MotDePasse!2026\",\n  \"password_confirm\": \"MotDePasse!2026\"\n}"
            },
            "description": "Crée un compte. Il reste inactif tant qu'un administrateur ne l'a pas validé."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', data.access);",
                  "  pm.collectionVariables.set('refresh_token', data.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@weeb.fr\",\n  \"password\": \"MotDePasse!2026\"\n}"
            },
            "description": "Retourne une paire de tokens JWT. Renvoie 401 si le compte n'est pas encore validé."
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh/",
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Profil courant",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me/",
            "description": "Retourne le profil de l'utilisateur associé au token."
          }
        },
        {
          "name": "Mot de passe oublié - demande",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/password-reset/",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ada@weeb.fr\"\n}" },
            "description": "En développement, le lien est affiché dans la console du serveur Django."
          }
        },
        {
          "name": "Mot de passe oublié - confirmation",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/password-reset/confirm/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"REMPLACER_PAR_UID_DU_LIEN\",\n  \"token\": \"REMPLACER_PAR_TOKEN_DU_LIEN\",\n  \"new_password\": \"NouveauMotDePasse!2026\",\n  \"new_password_confirm\": \"NouveauMotDePasse!2026\"\n}"
            },
            "description": "Recopier `uid` et `token` depuis le lien affiché dans la console."
          }
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "Lister les articles",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/articles/",
            "description": "Endpoint public et paginé (10 articles par page)."
          }
        },
        {
          "name": "Créer un article",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('article_slug', pm.response.json().slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/articles/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Les tendances du web en 2026\",\n  \"excerpt\": \"Un tour d'horizon des nouveautés du développement web.\",\n  \"content\": \"Le web continue d'évoluer à un rythme soutenu. Voici les tendances qui comptent cette année.\",\n  \"cover_image\": \"\",\n  \"is_published\": true\n}"
            },
            "description": "Requiert un compte authentifié et validé. L'auteur est déduit du token."
          }
        },
        {
          "name": "Détail d'un article",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/articles/{{article_slug}}/"
          }
        },
        {
          "name": "Modifier un article",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/articles/{{article_slug}}/",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Les tendances du web, édition revue\"\n}" },
            "description": "Renvoie 403 si l'utilisateur n'est pas l'auteur de l'article."
          }
        },
        {
          "name": "Supprimer un article",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/articles/{{article_slug}}/",
            "description": "Renvoie 403 si l'utilisateur n'est pas l'auteur de l'article."
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Envoyer un message",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/contact/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Logan\",\n  \"last_name\": \"Donday\",\n  \"email\": \"logan@weeb.fr\",\n  \"message\": \"Bravo pour le blog, les articles sont très clairs.\"\n}"
            },
            "description": "Endpoint public. Le message est consultable dans l'admin Django."
          }
        }
      ]
    }
  ]
}
