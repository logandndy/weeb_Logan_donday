# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le fichier `.env` ne doit jamais être versionné.

# Clé de signature Django, 32 caractères minimum (les tokens JWT sont signés
# avec). En production, générer une valeur aléatoire avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cle-de-developpement-uniquement-a-remplacer-en-production

# Mettre à False en production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées à appeler l'API (serveur de développement Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL du frontend, utilisée dans le lien de réinitialisation de mot de passe.
FRONTEND_URL=http://localhost:5173

# En développement les emails sont affichés dans la console.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@weeb.local
